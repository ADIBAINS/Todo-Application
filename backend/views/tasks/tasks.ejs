<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>

<body>
    <style>
        .container {
            width: 70%;
            margin: 5rem auto;
            background-color: blueviolet;
        }

        .task {
            height: 3rem;
            background-color: aqua;
            margin: 0.5rem;
            border-radius: 0.5rem solid rgb(175, 85, 85);
            display: flex;
            justify-content: start;
            align-items: center;

        }

        .task-completed {
            text-decoration: line-through;
            text-decoration-thickness: 2px;
            text-decoration-color: black;
        }


        .task-status {
            width: 18px;
            height: 18px;
            appearance: none;
            /* Remove default browser checkbox */
            -webkit-appearance: none;
            background-color: #fff;
            border: 2px solid #444;
            border-radius: 50%;
            /* makes it a circle */
            cursor: pointer;
            transition: all 0.2s ease;
        }

        .task-status:checked {
            background-color: #4caf50;
            /* green when checked */
            border-color: #4caf50;
        }
    </style>
    <div class="container">
        <div class="task-list">
            <% tasks.forEach(task=> { %>
                <div class="task" id="<%= task._id %>">
                    <input type="checkbox" class="task-status" value="true" <%=task.status ? "checked" : "" %>>
                    <p class="task-title <%= task.status ? 'task-completed' : '' %>">
                        <%= task.title %>
                    </p>
                    <button class="task-edit-btn">Edit Task</button>
                </div>
                <% }) %>
        </div>

        <div class="task-creation">
            <form action="/tasks" method="post">
                <input type="text" class="task-creation-title" name="title">
                <button class="task-creation-btn">Add Task</button>
            </form>
        </div>
    </div>

</body>

</html>


<script>
    document.querySelectorAll(".task-status").forEach(checkbox => {
        checkbox.addEventListener("click", async (e) => {
            const taskDiv = e.target.closest(".task");
            const titleEl = taskDiv.querySelector(".task-title");
            const id = taskDiv.getAttribute("id");
            const status = e.target.checked;
            titleEl.classList.toggle("task-completed", status);
            try {
                const res = await fetch(`/tasks/${id}`, {
                    method: "PUT",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({ status })
                });

            } catch (err) {
                console.error("Error updating task:", err);
            }
        });
    });
</script>